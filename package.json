{
  "name": "getverse",
  "productName": "GetVerse",
  "version": "1.0.0",
  "description": "Projection de versets bibliques pendant le culte",
  "main": "src/main.js",
  "author": "GetVerse",
  "scripts": {
    "start": "electron .",
    "build:data": "node scripts/build-bibles.js",
    "build:assets": "node scripts/build-assets.js",
    "dist": "electron-builder --win nsis && node scripts/copy-installer.js"
  },
  "build": {
    "appId": "com.getverse.app",
    "productName": "GetVerse",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/lsg.json",
      "data/bds.json",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GetVerse",
      "include": "build/installer.nsh",
      "menuCategory": "GetVerse",
      "language": "1036",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}